# Same Supabase project URL and public publishable/legacy anon key as the frontend.
# No service-role key is required: database calls use the signed-in user's token.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
WEB_ORIGIN=http://localhost:5173
PORT=3001
HOST=127.0.0.1

# M3 initial generation: server-only provider configuration.
# Server-side secrets. Never copy these to apps/web or VITE_* variables.
GROQ_API_KEY=
GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.5-flash-lite

AI_PRIMARY_PROVIDER=groq

GROQ_MODEL=openai/gpt-oss-20b

# Optional server-only venue/food directory provider.
GEOAPIFY_API_KEY=
